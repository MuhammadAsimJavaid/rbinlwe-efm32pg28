{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "project",
      "displayName": "Configure MLKEM512_on_EFM32PG28",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "base"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default_config",
      "displayName": "Build MLKEM512_on_EFM32PG28",
      "configurePreset": "project",
      "configuration": "base",
      "targets": ["MLKEM512_on_EFM32PG28"]
    }
  ],
  "workflowPresets": [
    {
      "name": "project",
      "steps": [
        {"type": "configure", "name": "project"},
        {"type": "build", "name": "default_config"}
      ]
    }
  ]
}
